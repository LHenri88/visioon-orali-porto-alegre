    <!-- CSS personalizado -->
    <style>
/* Estilos globais */
body {
    font-family: 'Poppins', sans-serif;
    color: #333; /* Cor de texto principal */
    background-color: #ffffff; /* Fundo branco */
}

/* Navbar (Cabeçalho) */
.navbar {
    background: #344f73 !important; /* Azul principal */
    padding: 15px 0;
}

.navbar-brand img {
    height: 50px; /* Altura da logo */
}

.navbar-nav .nav-link {
    color: #ffffff !important; /* Texto branco */
    font-weight: 500;
    margin: 0 10px;
}

.navbar-nav .nav-link:hover {
    color: #ffd700 !important; /* Amarelo no hover */
}

/* Seção Hero (Destaque) */


/* Títulos das seções */
.section-title {
    color: #0077b6; /* Azul principal */
    font-weight: 700;
    margin-bottom: 30px;
    text-align: center;
}

/* Cards de serviços */
.card {
    border: none;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-10px);
}

.card img {
    border-radius: 10px 10px 0 0;
}

.card-title {
    color: #0077b6; /* Azul principal */
    font-weight: 600;
}

.btn-primary {
    background: #0077b6; /* Azul principal */
    border: none;
    padding: 10px 20px;
    font-weight: 500;
    color: #ffffff; /* Texto branco */
}

.btn-primary:hover {
    background: #005f8a; /* Azul mais escuro no hover */
}

/* Seção de Avaliações */
.reviews {
    background: #f8f9fa; /* Fundo cinza claro */
    padding: 60px 0;
}

.review-card {
    background: #ffffff; /* Fundo branco */
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    text-align: center;
}

.review-card img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    margin-bottom: 15px;
}

.review-card .stars {
    color: #ffd700; /* Amarelo para as estrelas */
    font-size: 1.5rem;
    margin-bottom: 10px;
}

.review-card .review-text {
    font-style: italic;
    color: #555555; /* Cinza para o texto da avaliação */
}

/* Seção de Contato */
.contact {
    background: #ffffff; /* Fundo branco */
    padding: 60px 0;
}

.map-container {
    margin-top: 30px;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

/* Rodapé */
footer {
    background: #182836; /* Azul escuro */
    color: #ffffff; /* Texto branco */
    padding: 20px 0;
    text-align: center;
}

footer a {
    color: #ffd700; /* Amarelo para links */
    text-decoration: none;
}

footer a:hover {
    color: #ffffff; /* Branco no hover */
}



/* Estilo personalizado para os botões do carrossel */
#reviewCarousel {min-height:330px;}
.carousel-control-prev,
.carousel-control-next {
    background-color: #344f73; /* Nova cor */
    width: 40px; /* Largura do botão */
    height: 40px; /* Altura do botão */
    border-radius: 50%; /* Deixa o botão redondo */
    top: 130px; /* 50% Centraliza verticalmente */
    transform: translateY(-50%); /* Ajuste fino para centralização */
    opacity: 0.8; /* Transparência */
	
}

.carousel-control-prev:hover,
.carousel-control-next:hover {
    background-color: #2a3f5d; /* Cor mais escura no hover */
    opacity: 1; /* Remove a transparência no hover */
}

/* Ícones dos botões (setas) */
.carousel-control-prev-icon,
.carousel-control-next-icon {
    filter: brightness(0) invert(1); /* Transforma o ícone em branco */
}


.voltar-ao-topo {
            position: fixed;
            bottom: 2em;
            right: 2em;
            text-decoration: none;
            color: white;
            background-color: rgba(0, 0, 0, 0.3);
            font-size: 10px;
            padding: 1em;
			display:none;	
			border-radius: 50%; /* Deixa o botão redondo */

			
        }
        .voltar-ao-topo:hover {
            background-color: rgba(0, 0, 0, 0.4);
			
        }
.voltar-ao-topo img {
	width:25px;
	height:auto;
	opacity : 0.5;
}
.voltar-ao-topo img:hover {
	opacity : 1;
}

.copyright-amor a {
	color:#FFF;	
}
.copyright-amor img{
	width:16px;
	height:auto;	
}

		@keyframes pulse { /* EFEITO PARA PULSAR O BOTAO DO WHATSAPP*/
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
}

        #b_whats {
            position: fixed;
            bottom: 80px;
            right: 0;
            padding: 10px;
            z-index: 10000000;
			animation: pulse 1s infinite;/* EFEITO PARA PULSAR O BOTAO DO WHATSAPP*/
        }

    /* Seção Hero (Destaque) */

.hero {
    /*background: #0077b6; /* Fundo azul para a seção */
    padding: 90px 0; /* Aumentei o espaçamento interno */
}

.hero h1 {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 30px; /* Aumentei o espaçamento abaixo do título */
}
.hero span {
    font-size: 3.5rem;
    font-weight: 700;
    /*margin-bottom: 30px; /* Aumentei o espaçamento abaixo do título */
	color: #0077b6; 
}

.hero p {
    font-size: 1.2rem;
    line-height: 1.8; /* Aumentei a altura da linha */
    max-width: 100%; /* Largura máxima do texto */
    margin-bottom: 0; /* Removi a margem inferior do parágrafo */
	
}

.hero img {
    max-width: 100%; /* Garante que a imagem não ultrapasse o container */
    height: auto; /* Mantém a proporção da imagem */
    border-radius: 10px; /* Bordas arredondadas */
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4); /* Sombra suave */
	
}
.doido{
	color:#000!important;
	background-color:RGBA(248,249,250,var(--bs-bg-opacity,1))!important;
}


        /* Carousel Instagram */
        .Carousel_Insta {
            overflow: hidden;
            position: relative;
        }

        .Carousel_Insta-inner {
            display: flex;
            transition: transform 0.5s ease;
        }

        .Carousel_Insta-item {
            flex: 0 0 100%;
            max-width: 95%;
            padding: 0 10px;
            box-sizing: border-box;
			
        }
		.Carousel_Insta-item img {
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);	
		}

        .Carousel_Insta-image {
            width: 100%;
            height: auto;
            border-radius: 10px;
            object-fit: cover;
        }

        /* Controles de navegação Instagram*/
        .Carousel_Insta-control {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0,0,0,0.5);
            border: none;
            color: white;
            padding: 10px;
            cursor: pointer;
            z-index: 1;
        }

        .Carousel_Insta-control.prev {
            left: 10px;
        }

        .Carousel_Insta-control.next {
            right: 10px;
        }

        /* Responsividade */


        @media (min-width: 768px) {
            .Carousel_Insta-item {
                flex: 0 0 100%;
                max-width: 100%;
            }
			
        }

        @media (max-width: 639px) {
            .Carousel_Insta-item {
                flex: 0 0 100%;
                max-width: 100%;
            }
		
        }
		
		@media (max-width: 488px) {
		#reviewCarousel {min-height:480px;}		
		}
		@media screen and (min-width:489px) and (max-width: 767px) {
		#reviewCarousel {min-height:420px;}	
			
		}
		@media screen and (min-width:768px) and (max-width:991px){
		#reviewCarousel {min-height:355px;}	
		}
		
        .accordion-button {
            font-weight: bold; /* Deixa as perguntas em negrito */
            color: #0077b6; /* Cor azul principal */
        }
        .accordion-button:not(.collapsed) {
            background-color: #f8f9fa; /* Fundo claro quando expandido */
            color: #023e8a; /* Cor azul escuro quando expandido */
        }
        .accordion-body {
            color: #333; /* Cor do texto das respostas */
        }
		
		
		
.navbar-social {
    margin-left: auto; /* Alinha os ícones à direita */
    padding: 10px 0; /* Espaçamento interno */
}

.navbar-social .nav-link {
    padding: 0 10px; /* Espaçamento entre os ícones */
}

.navbar-social img {
    transition: opacity 0.3s ease; /* Efeito de transição suave */
}

.navbar-social img:hover {
    opacity: 0.7; /* Efeito de hover nos ícones */
}

    </style>
</head>
