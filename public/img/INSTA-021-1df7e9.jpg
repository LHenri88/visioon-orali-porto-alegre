<script>
document.addEventListener('DOMContentLoaded', function() {
    const navbarNav = document.getElementById('navbarNav');
    const hamburger = document.getElementById('hamburger');

    // Fecha o menu quando o usuário clica fora dele
    document.addEventListener('click', function(event) {
        const isClickInsideMenu = navbarNav.contains(event.target); // Verifica se o clique foi dentro do menu
        const isClickOnHamburger = hamburger.contains(event.target); // Verifica se o clique foi no botão do menu

        // Se o clique foi fora do menu e fora do botão do menu, fecha o menu
        if (!isClickInsideMenu && !isClickOnHamburger) {
            const bsCollapse = new bootstrap.Collapse(navbarNav, {
                toggle: false
            });
            bsCollapse.hide();
        }
    });
});
</script>
