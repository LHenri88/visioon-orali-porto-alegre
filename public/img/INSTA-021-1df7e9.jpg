        <button class="Carousel_Insta-control next">›</button>
    </div>
<script>
    // Script de controle do carrossel
    const carouselInner = document.querySelector('.Carousel_Insta-inner');
    const items = document.querySelectorAll('.Carousel_Insta-item');
    let currentIndex = 0;

    // Função para avançar o slide
    function nextSlide() {
        if (currentIndex < items.length - 1) {
            currentIndex++;
        } else {
            currentIndex = 0; // Volta ao primeiro slide
        }
        updateCarousel();
    }

    // Função para retroceder o slide
    function prevSlide() {
        if (currentIndex > 0) {
            currentIndex--;
        } else {
            currentIndex = items.length - 1; // Vai para o último slide
        }
        updateCarousel();
    }

    // Atualiza a posição do carrossel
    function updateCarousel() {
        const offset = -currentIndex * 100;
        carouselInner.style.transform = `translateX(${offset}%)`;
    }

    // Controles de navegação
    document.querySelector('.next').addEventListener('click', nextSlide);
    document.querySelector('.prev').addEventListener('click', prevSlide);

    // Rotaçao automática
    let autoSlideInterval = setInterval(nextSlide, 5000); // Avança o slide a cada 5 segundos

    // Pausa a rotação automática quando o mouse está sobre o carrossel
    const carousel = document.querySelector('.Carousel_Insta');
    carousel.addEventListener('mouseenter', () => {
        clearInterval(autoSlideInterval);
    });

    // Retoma a rotação automática quando o mouse sai do carrossel
    carousel.addEventListener('mouseleave', () => {
        autoSlideInterval = setInterval(nextSlide, 5000);
    });

    // Adaptação automática ao redimensionar
    window.addEventListener('resize', updateCarousel);
</script>    
